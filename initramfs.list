# Extra files packed into the initramfs, on top of everything in rootfs/.
# One per line:   <path in the image>   <host path, relative to the repo root>   [octal mode]
# Example:        /Commands/text        target/user/.../release/text             755
# A missing host file is skipped with a cargo warning, so the kernel still builds
# before the user programs do. See docs/filesystem.md ("The tree") for where things go:
# an app (it has a window) in /Apps/<name>/, a command (you type it) in /Commands, a
# service (it runs in the background, milkd starts it) in /System/Services, a test or
# developer tool in /System/Developer.

# The first program (PID 1).
/System/Startup/init                              target/user/aarch64-unknown-none-softfloat/release/init       755

# Services: background helpers, started and supervised by milkd from
# /System/Settings/milk/services (milkd itself is started by init).
/System/Services/alarmd                           target/user/aarch64-unknown-none-softfloat/release/alarmd     755
/System/Services/httpd                            target/user/aarch64-unknown-none-softfloat/release/httpd      755
/System/Services/milkd                            target/user/aarch64-unknown-none-softfloat/release/milkd      755
/System/Services/rngd                             target/user/aarch64-unknown-none-softfloat/release/rngd       755
/System/Services/soundd                           target/user/aarch64-unknown-none-softfloat/release/soundd     755
/System/Services/trashd                           target/user/aarch64-unknown-none-softfloat/release/trashd     755

# Apps: one folder each, the program next to its manifest (rootfs/Apps/<name>/manifest).
# Paint and Peek have no dock line in theirs (the desktop has its own Paint tile; Peek is
# the powerbox demo).
/Apps/activity/activity                           target/user/aarch64-unknown-none-softfloat/release/activity   755
/Apps/calendar/calendar                           target/user/aarch64-unknown-none-softfloat/release/calendar   755
/Apps/clock/clock                                 target/user/aarch64-unknown-none-softfloat/release/clock      755
/Apps/diskutil/diskutil                           target/user/aarch64-unknown-none-softfloat/release/diskutil   755
/Apps/texteditor/texteditor                       target/user/aarch64-unknown-none-softfloat/release/texteditor  755
/Apps/preview/preview                             target/user/aarch64-unknown-none-softfloat/release/preview     755
/Apps/paint/paint                                 target/user/aarch64-unknown-none-softfloat/release/paint      755
/Apps/peek/peek                                   target/user/aarch64-unknown-none-softfloat/release/peek       755
/Apps/reminders/reminders                         target/user/aarch64-unknown-none-softfloat/release/reminders  755
/Apps/store/store                                 target/user/aarch64-unknown-none-softfloat/release/store      755

# Commands: what Terminal finds on PATH (/Commands). The user/ workspace's command-line
# programs; coreutils (user/coreutils/src/bin/*.rs) are one small program each.
/Commands/msh                                     target/user/aarch64-unknown-none-softfloat/release/msh        755
/Commands/snap                                    target/user/aarch64-unknown-none-softfloat/release/snap       755
/Commands/fetch                                   target/user/aarch64-unknown-none-softfloat/release/fetch      755
/Commands/chmod                                   target/user/aarch64-unknown-none-softfloat/release/chmod      755
/Commands/chown                                   target/user/aarch64-unknown-none-softfloat/release/chown      755
/Commands/processes                               target/user/aarch64-unknown-none-softfloat/release/processes  755
/Commands/services                                target/user/aarch64-unknown-none-softfloat/release/services   755
/Commands/system                                  target/user/aarch64-unknown-none-softfloat/release/system     755
# Set-user-ID root (4755): they check a password themselves, then switch ids (users:
# password and switch; admin: COMMAND as root). Their other subcommands give root up first.
/Commands/users                                   target/user/aarch64-unknown-none-softfloat/release/users      4755
/Commands/admin                                   target/user/aarch64-unknown-none-softfloat/release/admin      4755
/Commands/clear                                   target/user/aarch64-unknown-none-softfloat/release/clear      755
# Files and folders (files replaced mv cp touch rm mkdir ls ln), and the Trash.
/Commands/files                                   target/user/aarch64-unknown-none-softfloat/release/files      755
/Commands/trash                                   target/user/aarch64-unknown-none-softfloat/release/trash      755
# Text (text replaced cat head tail grep sort uniq wc), print (echo) and pause (sleep).
/Commands/text                                    target/user/aarch64-unknown-none-softfloat/release/text       755
/Commands/print                                   target/user/aarch64-unknown-none-softfloat/release/print      755
/Commands/pause                                   target/user/aarch64-unknown-none-softfloat/release/pause      755
/Commands/df                                      target/user/aarch64-unknown-none-softfloat/release/df         755
/Commands/false                                   target/user/aarch64-unknown-none-softfloat/release/false      755
/Commands/true                                    target/user/aarch64-unknown-none-softfloat/release/true       755
/Commands/stty                                    target/user/aarch64-unknown-none-softfloat/release/stty       755
/Commands/open                                    target/user/aarch64-unknown-none-softfloat/release/open       755
/Commands/notify                                  target/user/aarch64-unknown-none-softfloat/release/notify     755
/Commands/today                                   target/user/aarch64-unknown-none-softfloat/release/today      755
/Commands/spaces                                  target/user/aarch64-unknown-none-softfloat/release/spaces     755
/Commands/cowsay                                  target/user/aarch64-unknown-none-softfloat/release/cowsay     755
/Commands/alarm                                   target/user/aarch64-unknown-none-softfloat/release/alarm      755
/Commands/timer                                   target/user/aarch64-unknown-none-softfloat/release/timer      755
/Commands/cal                                     target/user/aarch64-unknown-none-softfloat/release/cal        755
/Commands/remind                                  target/user/aarch64-unknown-none-softfloat/release/remind     755
/Commands/ifconfig                                target/user/aarch64-unknown-none-softfloat/release/ifconfig   755
/Commands/netstat                                 target/user/aarch64-unknown-none-softfloat/release/netstat    755
/Commands/ping                                    target/user/aarch64-unknown-none-softfloat/release/ping       755
/Commands/nc                                      target/user/aarch64-unknown-none-softfloat/release/nc         755
/Commands/play                                    target/user/aarch64-unknown-none-softfloat/release/play       755
/Commands/audit                                   target/user/aarch64-unknown-none-softfloat/release/audit      755
/Commands/milk                                    target/user/aarch64-unknown-none-softfloat/release/milk       755
/Commands/drop                                    target/user/aarch64-unknown-none-softfloat/release/drop       755
/Commands/netctl                                  target/user/aarch64-unknown-none-softfloat/release/netctl     755
/Commands/versions                                target/user/aarch64-unknown-none-softfloat/release/versions   755
/Commands/dedupe                                  target/user/aarch64-unknown-none-softfloat/release/dedupe     755
/Commands/spot                                    target/user/aarch64-unknown-none-softfloat/release/spot       755

# Developer tools: test harnesses and demos, not things you type day to day. Not on PATH;
# the test scripts run them by full path (/System/Developer/utest).
/System/Developer/hello                           target/user/aarch64-unknown-none-softfloat/release/hello      755
/System/Developer/fault                           target/user/aarch64-unknown-none-softfloat/release/fault      755
/System/Developer/utest                           target/user/aarch64-unknown-none-softfloat/release/utest      755
/System/Developer/chroot                          target/user/aarch64-unknown-none-softfloat/release/chroot     755
/System/Developer/sandbox                         target/user/aarch64-unknown-none-softfloat/release/sandbox    755
/System/Developer/tcpbench                        target/user/aarch64-unknown-none-softfloat/release/tcpbench   755
/System/Developer/fsstress                        target/user/aarch64-unknown-none-softfloat/release/fsstress   755

# Linux program compatibility: a static Linux/aarch64 program with no milkOS knowledge,
# linked at 0x400000 (tests/linux/build.sh; the program is committed). `utest linux` runs it.
/System/Developer/linux-hello                     tests/linux/bin/linux-hello                                   755

# Font licences (the desktop's baked system fonts, kernel/src/sysfont.rs, and Unifont).
/System/Fonts/FIGTREE-OFL.txt                     assets/fonts/FIGTREE-OFL.txt                                  644
/System/Fonts/IBM-PLEX-SANS-OFL.txt               assets/fonts/IBM-PLEX-SANS-OFL.txt                            644
/System/Fonts/FIRA-SANS-OFL.txt                   assets/fonts/FIRA-SANS-OFL.txt                                644
/System/Fonts/ATKINSON-HYPERLEGIBLE-NEXT-OFL.txt  assets/fonts/ATKINSON-HYPERLEGIBLE-NEXT-OFL.txt               644
/System/Fonts/UBUNTU-SANS-UFL.txt                 assets/fonts/UBUNTU-SANS-UFL.txt                              644
/System/Fonts/UNIFONT-LICENSE.txt                 assets/fonts/UNIFONT-LICENSE.txt                              644
